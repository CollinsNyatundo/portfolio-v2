{
  "name": "portfolio-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "lhci": "lhci autorun",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "prepare": "husky",
    "content": "node scripts/build-content.ts",
    "links": "node scripts/check-links.ts",
    "predev": "npm run content --silent",
    "prebuild": "npm run content --silent",
    "pretypecheck": "npm run content --silent",
    "pretest": "npm run content --silent",
    "test:py": "uv run --no-project --python 3.13 --with-requirements requirements.txt --with pytest==9.2.0 --with lightgbm==4.6.0 pytest tests/python -q -p no:cacheprovider",
    "smoke": "playwright test --config playwright.smoke.config.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.5",
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "basic-ftp": "6.2.5"
  }
}
